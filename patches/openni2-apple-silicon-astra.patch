--- /dev/null
+++ b/ThirdParty/PSCommon/BuildSystem/Platform.Arm64
@@ -0,0 +1,5 @@
+# Apple Silicon (macOS arm64)
+export GLUT_SUPPORTED=1
+P=$(LIBUSB_PREFIX)
+CFLAGS += -arch arm64 -O2 -I$(P)/include -Wno-error -std=c++11
+LDFLAGS += -arch arm64 -L$(P)/lib -Wl,-rpath,$(P)/lib
